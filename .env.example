# Database Configuration
POSTGRES_USER=snowboard
POSTGRES_PASSWORD=snowboard_password
POSTGRES_DB=snowboard_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://snowboard:snowboard_password@postgres:5432/snowboard_db

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# Storage Configuration
# For MVP: use local filesystem (STORAGE_BACKEND=local)
# For production: use S3/MinIO (STORAGE_BACKEND=s3)
STORAGE_BACKEND=local
STORAGE_ROOT=/app/runtime/storage

# S3/MinIO Configuration (optional, only if STORAGE_BACKEND=s3)
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET_NAME=snowboard-storage
# S3_REGION=us-east-1

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Triton Inference Server (for future use)
# TRITON_URL=http://triton:8000

# Pose Worker (local Ultralytics adapter)
POSE_MODEL_PATH=yolov8n-pose.pt
POSE_DEVICE=cpu
POSE_IMGSZ=640
POSE_CONF=0.25
POSE_IOU=0.7

# Logging
LOG_LEVEL=INFO

# Pipeline Versions
PIPELINE_VERSION=v1
MODEL_VERSION=v1
FEATURES_VERSION=v1
RULESET_VERSION=v1
